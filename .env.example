# Server only: never prefix these secrets with VITE_ or NEXT_PUBLIC_.
# Leave DATABASE_URL empty to use SQLite locally. Use a separate test database
# for Preview/Development; do not connect preview builds to production data.
DATABASE_URL=
# Optional direct/session connection for schema/data migration.
DATABASE_MIGRATION_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_STORAGE_BUCKET=sapatri-private
SAPATRI_SETUP_TOKEN=
# Local SQLite source, never included in Git or deployment.
SAPATRI_DB=private-data/sapatri.sqlite
